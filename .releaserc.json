{
  "branches": [
    "main",
    "master",
    {
      "name": "beta",
      "prerelease": true
    },
    {
      "name": "alpha",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "docs", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "breaking": true, "release": "major" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "🚀 Fitur Baru" },
            { "type": "fix", "section": "🐛 Perbaikan Bug" },
            { "type": "perf", "section": "⚡ Peningkatan Performa" },
            { "type": "refactor", "section": "♻️ Refaktorisasi Kode" },
            { "type": "docs", "section": "📚 Dokumentasi" },
            { "type": "style", "section": "💄 Penyesuaian Gaya & Tampilan" },
            { "type": "test", "section": "🧪 Pengujian & Testing" },
            { "type": "chore", "section": "🔧 Pemeliharaan Sistem" }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# CHANGELOG - SIMASMUH\n\nSemua catatan perubahan dan pembaruan sistem SIMASMUH didokumentasikan di berkas ini."
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
