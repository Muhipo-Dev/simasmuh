generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(uuid())
  username          String            @unique
  email             String?           @unique
  password          String
  name              String
  role              String            @default("GURU")
  phone             String?
  avatarUrl         String?
  address           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subRole           String?
  subRole2          String?
  subRole3          String?
  subRole4          String?
  subRole5          String?
  nipNbm            String?
  announcements     Announcement[]
  systemAnnouncements SystemAnnouncement[]
  dailyAttendances  DailyAttendance[]
  uploadedFiles     FileHash[]
  izinKeluars       IzinKeluar[]
  sentNotifications Notification[]    @relation("NotificationSender")
  notifications     Notification[]
  paymentProofs     PaymentProof[]
  pengeluarans      Pengeluaran[]
  danaBantuans      DanaBantuan[]
  staffJournals     StaffJournal[]
  characterAssessments CharacterAssessment[]
  student           Student?
  employmentStatus  String?           @default("GTTP") // PTTP, GTTP, GTP, PTP
  isActive          Boolean           @default(true)
  bankName          String?           // misal: BNI, BRI, BSI, Mandiri, BCA, Jateng Syariah
  bankAccountNumber String?           // Nomor rekening bank
  bankAccountHolder String?           // Nama pemilik rekening bank
  payrollRecords    PayrollRecord[]
  teacherProfile    TeacherProfile?
  parentProfile     ParentProfile?
  sessions          UserSession[]
  presensiKegiatans PresensiKegiatan[]
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String?
  ipAddress   String?
  userAgent   String?
  device      String?
  browser     String?
  os          String?
  isActive    Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isActive])
}

model TeacherProfile {
  id                  String            @id @default(uuid())
  nip                 String?           @unique
  phone               String?
  lastEducation       String?
  certificationStatus String?
  certificationYear   Int?
  userId              String            @unique
  homeroomClasses     Class[]           @relation("HomeroomTeacher")
  homeroomJournals    HomeroomJournal[]
  schedules           Schedule[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingJournals    TeachingJournal[]
  teacherSubjects     TeacherSubject[]
}

model ParentProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  phone               String?
  occupation          String?
  address             String?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students            ParentStudent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model ParentStudent {
  id                  String            @id @default(uuid())
  parentId            String
  studentId           String
  relation            String?           @default("ORANG_TUA") // AYAH, IBU, WALI, ORANG_TUA
  parent              ParentProfile     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Class {
  id                String          @id @default(uuid())
  name              String
  gradeLevel        Int
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   TeacherProfile? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  schedules         Schedule[]
  students          Student[]

  @@unique([name, gradeLevel, academicYear])
}

model Student {
  id                 String         @id @default(uuid())
  nisn               String         @unique
  nis                String         @unique
  name               String
  gender             String
  classId            String
  userId             String?        @unique
  phone              String?
  parentPhone        String?
  program            String?
  gelombang          String?        @default("Gelombang 1")
  jalurPendaftaran   String?        @default("Mandiri")
  isActive           Boolean        @default(true)
  beasiswaPercentage Int            @default(0) @map("discountPercentage")
  beasiswaReason     String?        @map("discountReason")
  beasiswaSeragamPct Int            @default(0)
  beasiswaSppPct     Int            @default(0)
  beasiswaDppPct     Int            @default(0)
  bioData            String?
  attendances        Attendance[]
  grades             Grade[]
  payments           Payment[]
  paymentProofs      PaymentProof[]
  parentRelations    ParentStudent[]
  class              Class          @relation(fields: [classId], references: [id])
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtualAccount     String?
  tagihans           Tagihan[]
  virtualAccountTransactions VirtualAccountTransaction[]
  characterAssessments CharacterAssessment[]

  @@index([classId])
  @@index([virtualAccount])
}

model Subject {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  grades          Grade[]
  schedules       Schedule[]
  teacherSubjects TeacherSubject[]
}

model TeacherSubject {
  id        String         @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime       @default(now())
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model Schedule {
  id               String            @id @default(uuid())
  dayOfWeek        Int
  startTime        String
  endTime          String
  classId          String
  subjectId        String
  teacherId        String
  attendances      Attendance[]
  class            Class             @relation(fields: [classId], references: [id])
  subject          Subject           @relation(fields: [subjectId], references: [id])
  teacher          TeacherProfile    @relation(fields: [teacherId], references: [id])
  teachingJournals TeachingJournal[]

  @@unique([classId, subjectId, dayOfWeek, startTime])
}

model Attendance {
  id         String   @id @default(uuid())
  date       DateTime
  status     String
  studentId  String
  scheduleId String
  createdAt  DateTime @default(now())
  location   String?
  photoUrl   String?
  updatedAt  DateTime @updatedAt
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, scheduleId, date])
}

model DailyAttendance {
  id           String   @id @default(uuid())
  date         DateTime
  checkInTime  String?
  checkOutTime String?
  time         String
  status       String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@index([date])
}

model Grade {
  id        String  @id @default(uuid())
  type      String
  score     Float
  studentId String
  subjectId String
  semester  Int
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, type, semester])
}

model TeachingJournal {
  id         String         @id @default(uuid())
  date       DateTime
  material   String
  notes      String?
  scheduleId String
  teacherId  String
  photoUrl   String?
  schedule   Schedule       @relation(fields: [scheduleId], references: [id])
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])

  @@unique([scheduleId, teacherId, date])
}

model HomeroomJournal {
  id          String         @id @default(uuid())
  date        DateTime
  notes       String
  actionTaken String?
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model Setting {
  id                  String  @id @default(uuid())
  schoolName          String
  address             String
  phone               String?
  email               String?
  logoUrl             String?
  principalName       String?
  principalNip        String?
  qrPublicToken       String?
  bankName            String?
  bankNumber          String?
  bankOwner           String?
  academicYear        String? @default("2026/2027")
  semester            String? @default("Ganjil")
  defaultDpp           Float?  @default(0)
  defaultUka           Float?  @default(0)
  defaultUks           Float?  @default(0)
  defaultInfaq         Float?  @default(0)
  defaultSeragam       Float?  @default(2000000)
  whatsappSenderNumber String? @default("088293733330")
  whatsappApiKey       String?
  whatsappApiUrl       String?
  helpdeskPhone        String? @default("088293733330")
  backgroundUrl        String?
  timezone             String? @default("Asia/Jakarta")
  serverLocation       String? @default("Ponorogo, Jawa Timur")
  smtpHost             String? @default("mail.smamuhipo.sch.id")
  smtpPort             Int?    @default(465)
  smtpUser             String? @default("dev@smamuhipo.sch.id")
  smtpPass             String?
  smtpFrom             String? @default("dev@smamuhipo.sch.id")
  smtpFromName         String? @default("SIMASMUH SMA Muhammadiyah 1 Ponorogo")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  eventDate DateTime?
  image     String?
  type      String    @default("BERITA") // BERITA, AGENDA
  author    User      @relation(fields: [authorId], references: [id])
}

model SystemAnnouncement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String    @default("SEMUA")
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     String?
  type      String    @default("PENGUMUMAN") // PENGUMUMAN, INFORMASI
  isUrgent  Boolean   @default(false) // Jika true, muncul mendesak sebagai popup otomatis setelah login di dashboard pengguna
  author    User      @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([type])
  @@index([isUrgent])
  @@index([createdAt])
}

model StaffJournal {
  id        String   @id @default(uuid())
  date      DateTime
  activity  String
  notes     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, activity])
}

model IzinKeluar {
  id              String    @id @default(uuid())
  date            DateTime
  waktuKeluar     String
  estimasiKembali String?
  alasan          String
  status          String    @default("MENUNGGU")
  catatanAdmin    String?
  userId          String
  eSignToken      String?
  eSignSignedAt   DateTime?
  eSignSignedBy   String?
  eSignHash       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eSignToken])
}

model Payment {
  id          String   @id @default(uuid())
  studentId   String
  tagihanId   String?
  type        String
  amount      Float
  paymentDate DateTime @default(now())
  month       Int?
  year        Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan     Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tagihanId])
  @@index([year, month])
}

model Tagihan {
  id            String         @id @default(uuid())
  studentId     String
  type          String
  amount        Float
  amountPaid    Float          @default(0)
  month         Int?
  year          Int?
  dueDate       DateTime?
  status        String         @default("BELUM_LUNAS")
  paidDate      DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  paymentProofs PaymentProof[]
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  virtualAccountTransactions VirtualAccountTransaction[]

  @@unique([studentId, type, year, month])
  @@index([studentId, status])
  @@index([year, month, status])
  @@index([type])
}

model Pengeluaran {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float
  category    String   @default("UMUM")
  date        DateTime @default(now())
  recordedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [recordedBy], references: [id])

  @@index([date])
  @@index([category])
}

model PaymentProof {
  id             String    @id @default(uuid())
  studentId      String
  tagihanId      String?
  amount         Float
  proofUrl       String
  fileHash       String?
  status         String    @default("MENUNGGU_VERIFIKASI")
  notes          String?
  verifiedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  fileHashRecord FileHash? @relation(fields: [fileHash], references: [hash])
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan        Tagihan?  @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  verifiedUser   User?     @relation(fields: [verifiedBy], references: [id])
}

model FileHash {
  id            String         @id @default(uuid())
  hash          String         @unique
  filePath      String
  fileSize      Int
  uploadedBy    String
  createdAt     DateTime       @default(now())
  uploader      User           @relation(fields: [uploadedBy], references: [id])
  paymentProofs PaymentProof[]
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  senderId  String?
  type      String
  title     String
  message   String
  data      Json?
  priority  String    @default("NORMAL")
  status    String    @default("UNREAD")
  channel   String    @default("IN_APP")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@index([createdAt])
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  type         String   @unique
  title        String
  message      String
  emailSubject String?
  emailBody    String?
  smsTemplate  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgramConfig {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  defaultSpp      Float    @default(0)
  defaultBeasiswa Float    @default(0) @map("defaultDiscount")
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DanaBantuan {
  id                 String    @id @default(uuid())
  namaBantuan        String
  kategori           String    @default("SISWA")
  sumberDana         String    @default("Yayasan")
  nominal            Float
  penerima           String?
  tanggal            DateTime  @default(now())
  status             String    @default("DISETUJUI")
  keterangan         String?
  targetSync         String    @default("KEUANGAN_KELUAR")
  isSynced           Boolean   @default(false)
  syncedAt           DateTime?
  syncedReferenceId String?
  recordedBy         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [recordedBy], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@index([isSynced])
}

model VirtualAccountTransaction {
  id         String    @id @default(uuid())
  studentId  String
  tagihanId  String?
  vaNumber   String
  bankCode   String
  amount     Float
  status     String    @default("PENDING")
  reference  String    @unique
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan    Tagihan?  @relation(fields: [tagihanId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([tagihanId])
  @@index([reference])
}

model WhatsAppLog {
  id             String   @id @default(uuid())
  recipientPhone String
  recipientName  String?
  recipientRole  String?
  category       String   // ABSENSI, TAGIHAN, PEMBAYARAN, INFORMASI, SISTEM
  title          String?
  message        String
  senderNumber   String   @default("088293733330")
  status         String   @default("SENT") // SENT, PENDING, FAILED, SIMULATED
  error          String?
  createdAt      DateTime @default(now())

  @@index([recipientPhone])
  @@index([category])
  @@index([createdAt])
}

model SystemLog {
  id          String    @id @default(uuid())
  category    String    // AUTH, PRESENSI, KEUANGAN, WHATSAPP, AKADEMIK, SISTEM, SECURITY
  level       String    @default("INFO") // INFO, WARN, ERROR, CRITICAL
  action      String    // e.g. "USER_LOGIN", "PAYMENT_CREATED", "ABSEN_FACE", "WA_SEND", etc.
  message     String
  details     Json?     // structured metadata
  ipAddress   String?
  userAgent   String?
  userId      String?
  userName    String?
  userRole    String?
  isArchived  Boolean   @default(false)
  archiveId   String?
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([level])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@index([isArchived])
}

model CompressedLogArchive {
  id                  String    @id @default(uuid())
  filename            String    // e.g. "archives/2026-08/log_2026-08-19.json.gz"
  storagePath         String    // Supabase bucket path e.g. "system-logs/archives/2026-08/log_2026-08-19.json.gz"
  bucketName          String    @default("system-logs")
  category            String    @default("ALL") // ALL, SYSTEM, WHATSAPP, SECURITY, AUDIT
  originalSizeBytes   Int       // bytes before compression
  compressedSizeBytes Int       // bytes after compression (sekecil-kecilnya)
  compressionRatio    Float     // e.g. 92.5 (%)
  compressionAlgo     String    @default("GZIP_LEVEL_9") // GZIP_LEVEL_9, BROTLI_MAX
  recordCount         Int       @default(0)
  startDate           DateTime
  endDate             DateTime
  checksumSha256      String?
  uploadedToSupabase  Boolean   @default(true)
  supabaseUrl         String?
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([bucketName])
}

model CharacterAssessment {
  id              String    @id @default(uuid())
  studentId       String
  evaluatorId     String
  category        String    // ADAB_ETIKA, IBADAH, KEDISIPLINAN, PRESTASI_PENGHARGAAN, PELANGGARAN
  type            String    // POSITIF, NEGATIF, RUTIN, CATATAN_KONSELING
  title           String
  description     String?
  points          Int       @default(0)
  date            DateTime  @default(now())
  actionTaken     String?
  status          String    @default("SELESAI") // MENUNGGU, DALAM_PEMBINAAN, SELESAI
  notifyParent    Boolean   @default(true)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluator       User      @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId])
  @@index([evaluatorId])
  @@index([category])
  @@index([type])
  @@index([date])
}

model GuestBook {
  id          String   @id @default(uuid())
  namaTamu    String
  instansi    String
  kategori    String   @default("STUDI_TIRU") // STUDI_TIRU, PEJABAT, ALUMNI_IJAZAH, VENDOR_UMUM, ORANG_TUA, LAINNYA
  tujuan      String
  dituju      String   @default("Tata Usaha")
  kontak      String?
  tanggal     DateTime @default(now())
  waktu       String?
  status      String   @default("TIBA") // TIBA, PROSES, SELESAI
  catatan     String?
  qrCodeToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kategori])
  @@index([status])
  @@index([tanggal])
  @@index([createdAt])
}

model NotulensiRapat {
  id                String   @id @default(uuid())
  nomorNotulensi    String?  @unique
  judulRapat        String
  agenda            String?
  kategori          String   @default("RAPAT_DINAS") // RAPAT_DINAS, RAPAT_GURU, RAPAT_KOORDINASI_SDM, RAPAT_PIMPINAN, RAPAT_WALI_MURID, RAPAT_KOMITE
  tanggal           DateTime @default(now())
  waktuMulai        String?  // e.g. 08:00
  waktuSelesai      String?  // e.g. 11:30
  tempat            String   @default("Aula Utama")
  pemimpinRapat     String
  notulis           String
  pesertaHadirCount Int      @default(0)
  pesertaTotalCount Int      @default(0)
  daftarPeserta     String?  // Text daftar nama/peserta yang hadir
  poinPembahasan    String?  // Teks uraian jalannya pembahasan diskusi
  keputusanHasil    String   // Teks keputusan mutlak / hasil rapat
  tindakLanjut      String?  // Action plan tindak lanjut
  fotoDokumentasi   String?  // URL/Path foto dokumentasi rapat fisik
  fileLampiran      String?  // URL/Path berkas lampiran (PDF/materi)
  status            String   @default("FINAL") // DRAF, FINAL, DIVERIFIKASI
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kategori])
  @@index([status])
  @@index([tanggal])
  @@index([createdAt])
}

model KegiatanSekolah {
  id               String             @id @default(uuid())
  nomorKegiatan    String?            @unique // e.g. KEG-2026-001
  namaKegiatan     String             // e.g. Kajian Selasa Pagi
  kategori         String             @default("KAJIAN_SELASA_PAGI") // KAJIAN_SELASA_PAGI, WORKSHOP_PELATIHAN, UPACARA_APEL, PENGAJIAN_AKBAR, RAPAT_KHUSUS, KEGIATAN_LAIN
  tanggal          DateTime           @default(now())
  waktuMulai       String?            // e.g. 06:45
  waktuSelesai     String?            // e.g. 07:30
  tempat           String             @default("Masjid / Aula Utama")
  pemateri         String?            // e.g. Ustadz Ahmad, M.Pd.I
  penanggungJawab  String?            // e.g. Tim Humas & Ismuba
  ringkasanMateri  String?            // Resume/catatan materi kegiatan
  dokumentasiUrl   String?            // Foto dokumentasi / drive link
  qrCodeToken      String             @unique // Unique token for scanning QR
  status           String             @default("DIBUKA") // DIBUKA, SELESAI, DITUTUP, DIBATALKAN
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  presensis        PresensiKegiatan[]

  @@index([kategori])
  @@index([status])
  @@index([tanggal])
  @@index([qrCodeToken])
  @@index([createdAt])
}

model PresensiKegiatan {
  id             String          @id @default(uuid())
  kegiatanId     String
  userId         String
  namaPeserta    String
  nipNbm         String?
  role           String          @default("GURU")
  waktuPresensi  DateTime        @default(now())
  metode         String          @default("QR_SCAN") // QR_SCAN, MANUAL
  keterangan     String?         // Hadir tepat waktu, etc.
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  kegiatan       KegiatanSekolah @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kegiatanId, userId])
  @@index([kegiatanId])
  @@index([userId])
  @@index([waktuPresensi])
}

model SuratKeluar {
  id               String    @id @default(uuid())
  nomorSurat       String
  nomorAgenda      String?
  tujuanPenerima   String
  instansiPenerima String?
  perihal          String
  tanggalSurat     DateTime  @default(now())
  jenisSurat       String    @default("SURAT_KETERANGAN")
  penandatangan    String    @default("Kepala Sekolah")
  status           String    @default("DRAF") // DRAF, MENUNGGU_TTD, DISETUJUI, PERLU_REVISI, TERKIRIM, DIARSIPKAN
  catatan          String?
  catatanRevisi    String?
  eSignToken       String?   @unique // Token 3 huruf + 4 angka e.g. MHP8492
  eSignSignedAt    DateTime?
  signerName       String?
  signerNbm        String?
  signatureImage   String?   // Base64 / URL spesimen coretan tanda tangan asli Kepala Sekolah per token
  fileUrl          String?
  templateData     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([eSignToken])
  @@index([status])
  @@index([jenisSurat])
  @@index([createdAt])
}

model SuratMasuk {
  id               String          @id @default(uuid())
  nomorAgenda      String          // e.g. 266.d
  nomorSurat       String          // e.g. 400.3/2067/101.6.19/2026
  pengirim         String?
  instansi         String          // Asal Surat, e.g. Cabang Dinas Pendidikan Wilayah Ponorogo
  perihal          String          // e.g. Jatim Cybersecurity Competitron (JCC) bagi Pelajar SMA dan SMK
  tanggalSurat     DateTime        @default(now())
  tanggalDiterima  DateTime        @default(now())
  sifat            String          @default("RUTIN") // RAHASIA, PENTING, RUTIN
  kategori         String          @default("DINAS_DIKNAS") // DINAS_DIKNAS, MAJELIS_DIKDASMEN, KEMENAG, KERJASAMA, UNDANGAN, UMUM
  fileUrl          String?         // Dokumen surat asli yang diunggah
  ringkasan        String?
  statusDisposisi  String          @default("BELUM_DISPOSISI") // BELUM_DISPOSISI, MENUNGGU_VERIFIKASI, DISPOSISI_DISETUJUI, DITOLAK
  statusTahapan    String          @default("DITERIMA") // DITERIMA, DISAMPAIKAN, PENGECEKAN, PENYELESAIAN
  disposisi        SuratDisposisi?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([nomorAgenda])
  @@index([nomorSurat])
  @@index([sifat])
  @@index([statusDisposisi])
  @@index([createdAt])
}

model SuratDisposisi {
  id               String      @id @default(uuid())
  suratMasukId     String      @unique
  suratMasuk       SuratMasuk  @relation(fields: [suratMasukId], references: [id], onDelete: Cascade)
  nomorAgenda      String?     // Synchronized with SuratMasuk
  sifat            String      @default("RUTIN") // RAHASIA, PENTING, RUTIN
  statusTahapan    String      @default("DITERIMA") // DITERIMA, DISAMPAIKAN, PENGECEKAN, PENYELESAIAN
  tanggalDiterima  DateTime    @default(now())
  instruksi        Json        // Array selected checkboxes, e.g. ["Arsip", "Ditindak Lanjuti", ...]
  diteruskanKepada Json        // Object/Array e.g. { targets: ["Wakasek Kurikulum"], guruNama: "M. Raza", bagianNama: "", stafNama: "" }
  catatan          String?
  statusEsign      String      @default("MENUNGGU_VERIFIKASI") // MENUNGGU_VERIFIKASI, DISETUJUI, DITOLAK
  eSignToken       String?     @unique // e.g. DSP8492
  eSignSignedAt    DateTime?
  signerName       String?     // Sugeng Riadi, M.Pd.
  signerNbm        String?     // NBM. 974.501
  signatureImage   String?     // Base64 / URL spesimen coretan tanda tangan asli Kepala Sekolah per token
  catatanPenolak   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([eSignToken])
  @@index([statusEsign])
  @@index([createdAt])
}

model PayrollRecord {
  id                String   @id @default(uuid())
  userId            String
  month             Int      // 1-12
  year              Int      // e.g. 2026
  employmentStatus  String?  // PTTP, GTTP, GTP, PTP
  
  // Gaji Pokok (Otomatis berdasarkan Jumlah Jam x Satuan Tarif Perjam)
  totalHours        Float    @default(0)
  hourlyRate        Float    @default(0)
  baseSalary        Float    @default(0) // totalHours * hourlyRate
  
  // Tunjangan Presensi (Otomatis dari Log Absensi Masuk & Pulang)
  transportAllowance Float   @default(0) // Datang <= 07:05 (5k) + Pulang >= 15:00/13:30 (5k)
  mealAllowance     Float    @default(0) // Durasi Masuk s/d Pulang >= 6 jam (8k)
  totalAttendanceDays Int    @default(0)
  
  // Komponen Manual (Diinput bebas oleh Keuangan All / Superadmin)
  // Format JSON array: [{ name: "Tunjangan Jabatan", amount: 500000 }, ...]
  manualAllowances  Json?    // Array object { name: string, amount: number }
  // Format JSON array: [{ name: "Potongan Koperasi", amount: 100000 }, ...]
  manualDeductions  Json?    // Array object { name: string, amount: number }
  
  // Akumulasi Total
  totalAllowance    Float    @default(0)
  totalDeduction    Float    @default(0)
  netSalary         Float    @default(0) // baseSalary + transportAllowance + mealAllowance + manualAllowances - manualDeductions
  
  notes             String?
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([month, year])
  @@index([userId])
}




