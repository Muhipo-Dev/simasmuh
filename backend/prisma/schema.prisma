model SuratKeluar {
  id               String    @id @default(uuid())
  nomorSurat       String
  nomorAgenda      String?
  tujuanPenerima   String
  instansiPenerima String?
  perihal          String
  tanggalSurat     DateTime  @default(now())
  jenisSurat       String    @default("SURAT_KETERANGAN")
  penandatangan    String    @default("Kepala Sekolah")
  status           String    @default("DRAF") // DRAF, MENUNGGU_TTD, DISETUJUI, PERLU_REVISI, TERKIRIM, DIARSIPKAN
  catatan          String?
  catatanRevisi    String?
  eSignToken       String?   @unique // Token 3 huruf + 4 angka e.g. MHP8492
  eSignSignedAt    DateTime?
  signerName       String?
  signerNbm        String?
  signatureImage   String?   // Base64 / URL spesimen coretan tanda tangan asli Kepala Sekolah per token
  fileUrl          String?
  templateData     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([eSignToken])
  @@index([status])
  @@index([jenisSurat])
  @@index([createdAt])
}

model SuratMasuk {
  id               String          @id @default(uuid())
  nomorAgenda      String          // e.g. 266.d
  nomorSurat       String          // e.g. 400.3/2067/101.6.19/2026
  pengirim         String?
  instansi         String          // Asal Surat, e.g. Cabang Dinas Pendidikan Wilayah Ponorogo
  perihal          String          // e.g. Jatim Cybersecurity Competitron (JCC) bagi Pelajar SMA dan SMK
  tanggalSurat     DateTime        @default(now())
  tanggalDiterima  DateTime        @default(now())
  sifat            String          @default("RUTIN") // RAHASIA, PENTING, RUTIN
  kategori         String          @default("DINAS_DIKNAS") // DINAS_DIKNAS, MAJELIS_DIKDASMEN, KEMENAG, KERJASAMA, UNDANGAN, UMUM
  fileUrl          String?         // Dokumen surat asli yang diunggah
  ringkasan        String?
  statusDisposisi  String          @default("BELUM_DISPOSISI") // BELUM_DISPOSISI, MENUNGGU_VERIFIKASI, DISPOSISI_DISETUJUI, DITOLAK
  statusTahapan    String          @default("DITERIMA") // DITERIMA, DISAMPAIKAN, PENGECEKAN, PENYELESAIAN
  disposisi        SuratDisposisi?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([nomorAgenda])
  @@index([nomorSurat])
  @@index([sifat])
  @@index([statusDisposisi])
  @@index([createdAt])
}

model SuratDisposisi {
  id               String      @id @default(uuid())
  suratMasukId     String      @unique
  suratMasuk       SuratMasuk  @relation(fields: [suratMasukId], references: [id], onDelete: Cascade)
  nomorAgenda      String?     // Synchronized with SuratMasuk
  sifat            String      @default("RUTIN") // RAHASIA, PENTING, RUTIN
  statusTahapan    String      @default("DITERIMA") // DITERIMA, DISAMPAIKAN, PENGECEKAN, PENYELESAIAN
  tanggalDiterima  DateTime    @default(now())
  instruksi        Json        // Array selected checkboxes, e.g. ["Arsip", "Ditindak Lanjuti", ...]
  diteruskanKepada Json        // Object/Array e.g. { targets: ["Wakasek Kurikulum"], guruNama: "M. Raza", bagianNama: "", stafNama: "" }
  catatan          String?
  statusEsign      String      @default("MENUNGGU_VERIFIKASI") // MENUNGGU_VERIFIKASI, DISETUJUI, DITOLAK
  eSignToken       String?     @unique // e.g. DSP8492
  eSignSignedAt    DateTime?
  signerName       String?     // Sugeng Riadi, M.Pd.
  signerNbm        String?     // NBM. 974.501
  signatureImage   String?     // Base64 / URL spesimen coretan tanda tangan asli Kepala Sekolah per token
  catatanPenolak   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([eSignToken])
  @@index([statusEsign])
  @@index([createdAt])
}

model PayrollRecord {
  id                String   @id @default(uuid())
  userId            String
  month             Int      // 1-12
  year              Int      // e.g. 2026
  employmentStatus  String?  // PTTP, GTTP, GTP, PTP
  
  // Gaji Pokok (Otomatis berdasarkan Jumlah Jam x Satuan Tarif Perjam)
  totalHours        Float    @default(0)
  hourlyRate        Float    @default(0)
  baseSalary        Float    @default(0) // totalHours * hourlyRate
  
  // Tunjangan Presensi (Otomatis dari Log Absensi Masuk & Pulang)
  transportAllowance Float   @default(0) // Datang <= 07:05 (5k) + Pulang >= 15:00/13:30 (5k)
  mealAllowance     Float    @default(0) // Durasi Masuk s/d Pulang >= 6 jam (8k)
  totalAttendanceDays Int    @default(0)
  
  // Komponen Manual (Diinput bebas oleh Keuangan All / Superadmin)
  // Format JSON array: [{ name: "Tunjangan Jabatan", amount: 500000 }, ...]
  manualAllowances  Json?    // Array object { name: string, amount: number }
  // Format JSON array: [{ name: "Potongan Koperasi", amount: 100000 }, ...]
  manualDeductions  Json?    // Array object { name: string, amount: number }
  
  // Akumulasi Total
  totalAllowance    Float    @default(0)
  totalDeduction    Float    @default(0)
  netSalary         Float    @default(0) // baseSalary + transportAllowance + mealAllowance + manualAllowances - manualDeductions
  
  notes             String?
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([month, year])
  @@index([userId])
}

model StudentAchievement {
