generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(uuid())
  username          String            @unique
  email             String?           @unique
  password          String
  name              String
  role              String            @default("GURU")
  avatarUrl         String?
  address           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subRole           String?
  subRole2          String?
  subRole3          String?
  nipNbm            String?
  announcements     Announcement[]
  dailyAttendances  DailyAttendance[]
  uploadedFiles     FileHash[]
  izinKeluars       IzinKeluar[]
  sentNotifications Notification[]    @relation("NotificationSender")
  notifications     Notification[]
  paymentProofs     PaymentProof[]
  pengeluarans      Pengeluaran[]
  danaBantuans      DanaBantuan[]
  staffJournals     StaffJournal[]
  student           Student?
  teacherProfile    TeacherProfile?
}

model TeacherProfile {
  id                  String            @id @default(uuid())
  nip                 String?           @unique
  phone               String?
  lastEducation       String?
  certificationStatus String?
  certificationYear   Int?
  userId              String            @unique
  homeroomClasses     Class[]           @relation("HomeroomTeacher")
  homeroomJournals    HomeroomJournal[]
  schedules           Schedule[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingJournals    TeachingJournal[]
}

model Class {
  id                String          @id @default(uuid())
  name              String
  gradeLevel        Int
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   TeacherProfile? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  schedules         Schedule[]
  students          Student[]
}

model Student {
  id                 String         @id @default(uuid())
  nisn               String         @unique
  nis                String         @unique
  name               String
  gender             String
  classId            String
  userId             String?        @unique
  program            String?
  discountPercentage Int            @default(0)
  discountReason     String?
  attendances        Attendance[]
  grades             Grade[]
  payments           Payment[]
  paymentProofs      PaymentProof[]
  class              Class          @relation(fields: [classId], references: [id])
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagihans           Tagihan[]

  @@index([classId])
}

model Subject {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  grades    Grade[]
  schedules Schedule[]
}

model Schedule {
  id               String            @id @default(uuid())
  dayOfWeek        Int
  startTime        String
  endTime          String
  classId          String
  subjectId        String
  teacherId        String
  attendances      Attendance[]
  class            Class             @relation(fields: [classId], references: [id])
  subject          Subject           @relation(fields: [subjectId], references: [id])
  teacher          TeacherProfile    @relation(fields: [teacherId], references: [id])
  teachingJournals TeachingJournal[]
}

model Attendance {
  id         String   @id @default(uuid())
  date       DateTime
  status     String
  studentId  String
  scheduleId String
  createdAt  DateTime @default(now())
  location   String?
  photoUrl   String?
  updatedAt  DateTime @updatedAt
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])
}

model DailyAttendance {
  id           String   @id @default(uuid())
  date         DateTime
  checkInTime  String?
  checkOutTime String?
  time         String
  status       String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@index([date])
}

model Grade {
  id        String  @id @default(uuid())
  type      String
  score     Float
  studentId String
  subjectId String
  semester  Int
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
}

model TeachingJournal {
  id         String         @id @default(uuid())
  date       DateTime
  material   String
  notes      String?
  scheduleId String
  teacherId  String
  photoUrl   String?
  schedule   Schedule       @relation(fields: [scheduleId], references: [id])
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
}

model HomeroomJournal {
  id          String         @id @default(uuid())
  date        DateTime
  notes       String
  actionTaken String?
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
}

model Setting {
  id            String  @id @default(uuid())
  schoolName    String
  address       String
  phone         String?
  email         String?
  logoUrl       String?
  principalName String?
  principalNip  String?
  qrPublicToken String?
  bankName      String?
  bankNumber    String?
  bankOwner     String?
  academicYear  String? @default("2026/2027")
  semester      String? @default("Ganjil")
  defaultDpp    Float?  @default(0)
  defaultUka    Float?  @default(0)
  defaultUks    Float?  @default(0)
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  eventDate DateTime?
  image     String?
  type      String    @default("BERITA")
  author    User      @relation(fields: [authorId], references: [id])
}

model StaffJournal {
  id        String   @id @default(uuid())
  date      DateTime
  activity  String
  notes     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IzinKeluar {
  id              String   @id @default(uuid())
  date            DateTime
  waktuKeluar     String
  estimasiKembali String?
  alasan          String
  status          String   @default("MENUNGGU")
  catatanAdmin    String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(uuid())
  studentId   String
  tagihanId   String?
  type        String
  amount      Float
  paymentDate DateTime @default(now())
  month       Int?
  year        Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan     Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tagihanId])
  @@index([year, month])
}

model Tagihan {
  id            String         @id @default(uuid())
  studentId     String
  type          String
  amount        Float
  amountPaid    Float          @default(0)
  month         Int?
  year          Int?
  dueDate       DateTime?
  status        String         @default("BELUM_LUNAS")
  paidDate      DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  paymentProofs PaymentProof[]
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([year, month, status])
  @@index([type])
}

model Pengeluaran {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float
  category    String   @default("UMUM")
  date        DateTime @default(now())
  recordedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [recordedBy], references: [id])

  @@index([date])
  @@index([category])
}

model PaymentProof {
  id             String    @id @default(uuid())
  studentId      String
  tagihanId      String?
  amount         Float
  proofUrl       String
  fileHash       String?
  status         String    @default("MENUNGGU_VERIFIKASI")
  notes          String?
  verifiedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  fileHashRecord FileHash? @relation(fields: [fileHash], references: [hash])
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan        Tagihan?  @relation(fields: [tagihanId], references: [id])
  verifiedUser   User?     @relation(fields: [verifiedBy], references: [id])
}

model FileHash {
  id            String         @id @default(uuid())
  hash          String         @unique
  filePath      String
  fileSize      Int
  uploadedBy    String
  createdAt     DateTime       @default(now())
  uploader      User           @relation(fields: [uploadedBy], references: [id])
  paymentProofs PaymentProof[]
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  senderId  String?
  type      String
  title     String
  message   String
  data      Json?
  priority  String    @default("NORMAL")
  status    String    @default("UNREAD")
  channel   String    @default("IN_APP")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@index([createdAt])
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  type         String   @unique
  title        String
  message      String
  emailSubject String?
  emailBody    String?
  smsTemplate  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgramConfig {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  defaultSpp      Float    @default(0)
  defaultDiscount Float    @default(0)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DanaBantuan {
  id                 String    @id @default(uuid())
  namaBantuan        String
  kategori           String    @default("SISWA")
  sumberDana         String    @default("Yayasan")
  nominal            Float
  penerima           String?
  tanggal            DateTime  @default(now())
  status             String    @default("DISETUJUI")
  keterangan         String?
  targetSync         String    @default("KEUANGAN_KELUAR")
  isSynced           Boolean   @default(false)
  syncedAt           DateTime?
  syncedReferenceId String?
  recordedBy         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [recordedBy], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@index([isSynced])
}


