generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("GURU") // SUPERADMIN or GURU
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherProfile    TeacherProfile?
}

model TeacherProfile {
  id        String   @id @default(uuid())
  nip       String?  @unique
  phone     String?
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  schedules        Schedule[]
  teachingJournals TeachingJournal[]
  homeroomClasses  Class[]           @relation("HomeroomTeacher")
  homeroomJournals HomeroomJournal[]
}

model Class {
  id          String   @id @default(uuid())
  name        String   // e.g., "X IPA 1"
  gradeLevel  Int      // e.g., 10, 11, 12
  academicYear String  // e.g., "2023/2024"

  homeroomTeacherId String?
  homeroomTeacher   TeacherProfile? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  students    Student[]
  schedules   Schedule[]
}

model Student {
  id        String   @id @default(uuid())
  nisn      String   @unique
  nis       String   @unique
  name      String
  gender    String   // Laki-laki / Perempuan
  classId   String
  class     Class    @relation(fields: [classId], references: [id])

  attendances Attendance[]
  grades      Grade[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique

  schedules Schedule[]
  grades    Grade[]
}

model Schedule {
  id          String   @id @default(uuid())
  dayOfWeek   Int      // 1=Senin, 5=Jumat
  startTime   String   // e.g. "07:00"
  endTime     String
  classId     String
  subjectId   String
  teacherId   String

  class       Class    @relation(fields: [classId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])

  attendances Attendance[]
  teachingJournals TeachingJournal[]
}

model Attendance {
  id          String   @id @default(uuid())
  date        DateTime
  status      String   // HADIR, SAKIT, IZIN, ALPA
  studentId   String
  scheduleId  String

  student     Student  @relation(fields: [studentId], references: [id])
  schedule    Schedule @relation(fields: [scheduleId], references: [id])
}

model Grade {
  id          String   @id @default(uuid())
  type        String   // TUGAS, UTS, UAS
  score       Float
  studentId   String
  subjectId   String
  semester    Int

  student     Student  @relation(fields: [studentId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
}

model TeachingJournal {
  id          String   @id @default(uuid())
  date        DateTime
  material    String
  notes       String?
  scheduleId  String
  teacherId   String

  schedule    Schedule @relation(fields: [scheduleId], references: [id])
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
}

model HomeroomJournal {
  id          String   @id @default(uuid())
  date        DateTime
  notes       String
  actionTaken String?
  teacherId   String

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
}

model Setting {
  id          String   @id @default(uuid())
  schoolName  String
  address     String
  phone       String?
  email       String?
  logoUrl     String?
  principalName String?
  principalNip  String?
}
