  code        String?  // e.g. "item_1", "item_2"
  label       String   // e.g. "UU Sisdiknas (No 20 th 2003)"
  bobot       Float    @default(4)
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jenisId])
  @@index([kategori])
  @@index([orderIndex])
  @@index([isActive])
