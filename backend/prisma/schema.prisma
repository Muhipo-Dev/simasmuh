generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(uuid())
  username          String            @unique
  email             String?           @unique
  password          String
  name              String
  role              String            @default("GURU")
  phone             String?
  avatarUrl         String?
  address           String?
  notificationPreferences Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subRole           String?
  subRole2          String?
  subRole3          String?
  subRole4          String?
  subRole5          String?
  nipNbm            String?
  announcements     Announcement[]
  systemAnnouncements SystemAnnouncement[]
  dailyAttendances  DailyAttendance[]
  uploadedFiles     FileHash[]
  izinKeluars       IzinKeluar[]
  sentNotifications Notification[]    @relation("NotificationSender")
  notifications     Notification[]
  paymentProofs     PaymentProof[]
  pengeluarans      Pengeluaran[]
  danaBantuans      DanaBantuan[]
  staffJournals     StaffJournal[]
  characterAssessments CharacterAssessment[]
  student           Student?
  employmentStatus  String?           @default("GTTP") // PTTP, GTTP, GTP, PTP
  isActive          Boolean           @default(true)
  bankName          String?           // misal: BNI, BRI, BSI, Mandiri, BCA, Jateng Syariah
  bankAccountNumber String?           // Nomor rekening bank
  bankAccountHolder String?           // Nama pemilik rekening bank
  payrollRecords    PayrollRecord[]
  teacherProfile    TeacherProfile?
  parentProfile     ParentProfile?
  sessions          UserSession[]
  presensiKegiatans PresensiKegiatan[]
  passwordResetOtps PasswordResetOtp[]
  faceBiometric     UserFaceBiometric?
}

model PasswordResetOtp {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  otpCode   String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([otpCode])
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String?
  ipAddress   String?
  userAgent   String?
  device      String?
  browser     String?
  os          String?
  isActive    Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isActive])
}

model TeacherProfile {
  id                  String            @id @default(uuid())
  nip                 String?           @unique
  phone               String?
  lastEducation       String?
  certificationStatus String?
  certificationYear   Int?
  skUrl               String?           // File SK Pengangkatan / Penugasan Pegawai
  cvUrl               String?           // File CV / Portofolio Pegawai
  ijazahUrl           String?           // File Ijazah Terakhir Pegawai
  berkasUrl           String?           // Berkas / Sertifikat Tambahan Pegawai
  userId              String            @unique
  homeroomClasses     Class[]           @relation("HomeroomTeacher")
  homeroomJournals    HomeroomJournal[]
  schedules           Schedule[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingJournals    TeachingJournal[]
  teacherSubjects     TeacherSubject[]
  supervisiRecords    SupervisiAkademik[]
  supervisiJadwals    JadwalSupervisi[]
  perangkatAjars      PerangkatAjar[]
  studentAssessments  StudentAssessment[]
  perangkatKurikulums PerangkatKurikulum[]
  modulAjars          ModulAjar[]
  alurTujuanPembelajarans AlurTujuanPembelajaran[]
}

model ParentProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  phone               String?
  occupation          String?
  address             String?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students            ParentStudent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model ParentStudent {
  id                  String            @id @default(uuid())
  parentId            String
  studentId           String
  relation            String?           @default("ORANG_TUA") // AYAH, IBU, WALI, ORANG_TUA
  parent              ParentProfile     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Class {
  id                String          @id @default(uuid())
  name              String
  gradeLevel        Int
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   TeacherProfile? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  schedules         Schedule[]
  students          Student[]
  studentAssessments StudentAssessment[]
  perangkatKurikulums PerangkatKurikulum[]
  modulAjars          ModulAjar[]
  alurTujuanPembelajarans AlurTujuanPembelajaran[]

  @@unique([name, gradeLevel, academicYear])
}

model Student {
  id                 String         @id @default(uuid())
  nisn               String?        @unique
  nis                String         @unique
  name               String
  gender             String
  classId            String
  userId             String?        @unique
  phone              String?
  parentPhone        String?
  program            String?
  gelombang          String?        @default("Gelombang 1")
  jalurPendaftaran   String?        @default("Mandiri")
  isActive           Boolean        @default(true)
  beasiswaPercentage Int            @default(0) @map("discountPercentage")
  beasiswaReason     String?        @map("discountReason")
  beasiswaSeragamPct Int            @default(0)
  beasiswaSppPct     Int            @default(0)
  beasiswaDppPct     Int            @default(0)
  bioData            String?
  attendances        Attendance[]
  grades             Grade[]
  payments           Payment[]
  paymentProofs      PaymentProof[]
  parentRelations    ParentStudent[]
  class              Class          @relation(fields: [classId], references: [id])
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtualAccount     String?
  tagihans           Tagihan[]
  virtualAccountTransactions VirtualAccountTransaction[]
  characterAssessments CharacterAssessment[]
  achievements       StudentAchievement[]
  extracurricularMembers ExtracurricularMember[]
  studentAssessments StudentAssessment[]
  nilaiSiswaTps      NilaiSiswaTP[]

  @@index([classId])
  @@index([virtualAccount])
}

model Subject {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  category        String?          @default("WAJIB") // WAJIB | PILIHAN_PROGRAM | MUATAN_LOKAL
  program         String?          // e.g. "ai", "seni budaya", "tahfidz", dll (kode ProgramConfig)
  grades          Grade[]
  schedules       Schedule[]
  teacherSubjects TeacherSubject[]
  studentAssessments StudentAssessment[]
  perangkatKurikulums PerangkatKurikulum[]
  modulAjars          ModulAjar[]
  alurTujuanPembelajarans AlurTujuanPembelajaran[]
}

model TeacherSubject {
  id        String         @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime       @default(now())
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

model Schedule {
  id               String            @id @default(uuid())
  dayOfWeek        Int
  startTime        String
  endTime          String
  classId          String
  subjectId        String
  teacherId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  attendances      Attendance[]
  class            Class             @relation(fields: [classId], references: [id])
  subject          Subject           @relation(fields: [subjectId], references: [id])
  teacher          TeacherProfile    @relation(fields: [teacherId], references: [id])
  teachingJournals TeachingJournal[]
  modulAjars       ModulAjar[]

  @@unique([classId, subjectId, dayOfWeek, startTime])
}

model Attendance {
  id         String   @id @default(uuid())
  date       DateTime
  status     String
  studentId  String
  scheduleId String
  createdAt  DateTime @default(now())
  location   String?
  photoUrl   String?
  updatedAt  DateTime @updatedAt
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, scheduleId, date])
}

model DailyAttendance {
  id           String   @id @default(uuid())
  date         DateTime
  checkInTime  String?
  checkOutTime String?
  time         String
  status       String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@index([date])
}

model Grade {
  id        String  @id @default(uuid())
  type      String
  score     Float
  studentId String
  subjectId String
  semester  Int
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, type, semester])
}

model TeachingJournal {
  id               String         @id @default(uuid())
  date             DateTime
  material         String
  notes            String?
  scheduleId       String
  teacherId        String
  photoUrl         String?
  tpId             String?
  modulAjarId      String?
  
  tujuanPembelajaran TujuanPembelajaran? @relation(fields: [tpId], references: [id], onDelete: SetNull)
  modulAjar          ModulAjar?          @relation(fields: [modulAjarId], references: [id], onDelete: SetNull)
  schedule           Schedule            @relation(fields: [scheduleId], references: [id])
  teacher            TeacherProfile      @relation(fields: [teacherId], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@unique([scheduleId, teacherId, date])
  @@index([scheduleId])
  @@index([teacherId])
  @@index([tpId])
  @@index([modulAjarId])
}

model HomeroomJournal {
  id          String         @id @default(uuid())
  date        DateTime
  notes       String
  actionTaken String?
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model Setting {
  id                  String  @id @default(uuid())
  schoolName          String
  address             String
  phone               String?
  email               String?
  logoUrl             String?
  principalName       String?
  principalNip        String?
  qrPublicToken       String?
  bankName            String?
  bankNumber          String?
  bankOwner           String?
  academicYear        String? @default("2026/2027")
  semester            String? @default("Ganjil")
  defaultDpp           Float?  @default(0)
  defaultUka           Float?  @default(0)
  defaultUks           Float?  @default(0)
  defaultInfaq         Float?  @default(0)
  defaultSeragam       Float?  @default(2000000)
  whatsappSenderNumber String? @default("088293733330")
  whatsappApiKey       String?
  whatsappApiUrl       String?
  helpdeskPhone        String? @default("088293733330")
  backgroundUrl        String?
  timezone             String? @default("Asia/Jakarta")
  serverLocation       String? @default("Ponorogo, Jawa Timur")
  smtpHost             String? @default("mail.smamuhipo.sch.id")
  smtpPort             Int?    @default(465)
  smtpUser             String? @default("dev@smamuhipo.sch.id")
  smtpPass             String?
  smtpFrom             String? @default("dev@smamuhipo.sch.id")
  smtpFromName         String? @default("SIMASMUH SMA Muhammadiyah 1 Ponorogo")
  studentCardTemplateUrl String?
  publicDomainUrl        String? @default("https://simasmuh.razagopo.my.id")
  googleClientId         String?
  googleClientSecret     String?
  partnerLogos           String? // JSON stringified array of { id, title, imageUrl, linkUrl }
  youtubeChannelUrl      String? @default("https://www.youtube.com/@SmaMuhipo")
  youtubeVideoEmbedUrl   String?
  instagramUrl           String? @default("https://www.instagram.com/smamuhipo.official/")
  instagramFeedUrl       String?
  instagramPostsJson     String? // JSON array of { id, url, caption, imageUrl, date }
  whySchoolTitle         String? @default("Kenapa Harus Bersekolah di SMA Muhipo?")
  whySchoolSubtitle      String? @default("SMA Muhammadiyah 1 Ponorogo berkomitmen memberikan lingkungan belajar holistik yang memadukan keunggulan akademik, adab Islam, teknologi masa depan, dan prestasi global.")
  whySchoolFeaturesJson  String? // JSON array of { id, number, title, description, tag, icon, color }
  heroBadgeText          String? @default("Terakreditasi A • Sekolah Unggul Muhammadiyah")
  heroBadgeLocation      String? @default("Ponorogo, Jawa Timur")
  heroSubheading         String? @default("SMA MUHAMMADIYAH 1 PONOROGO (MUHIPO)")
  heroTitlePrefix        String? @default("EXCELLENT ISLAMIC")
  heroTitleGradient      String? @default("WITH CHARACTER")
  heroDescription        String? @default("Membentuk generasi unggul yang berakhlak mulia, berwawasan global, mandiri, serta berdaya saing internasional berlandaskan nilai-nilai luhur kepesantrenan dan pendidikan berkemajuan.")
  heroCtaText            String? @default("Kenapa SMA Muhipo?")
  heroCtaLink            String? @default("#keunggulan")
  heroVideoText          String? @default("Tonton Video Profil")
  heroVideoLink          String? @default("https://www.youtube.com/@SmaMuhipo")
  homeSectionOrderJson   String? // JSON stringified array of section keys: ['partner_logos', 'stats', 'news_agenda', 'why_school', 'programs', 'media_social']
  activeCurriculaJson    String? @default("[\"KURIKULUM_MERDEKA\"]") // Array kurikulum yang aktif di sekolah (maksimal 2)
  allCurriculaJson       String? // Custom kurikulum tambahan yang didaftarkan waka kurikulum (>10 kurikulum)
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  eventDate DateTime?
  image     String?
  type      String    @default("BERITA") // BERITA, AGENDA
  author    User      @relation(fields: [authorId], references: [id])
}

model SystemAnnouncement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String    @default("SEMUA")
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     String?
  type      String    @default("PENGUMUMAN") // PENGUMUMAN, INFORMASI
  isUrgent  Boolean   @default(false) // Jika true, muncul mendesak sebagai popup otomatis setelah login di dashboard pengguna
  author    User      @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([type])
  @@index([isUrgent])
  @@index([createdAt])
}

model StaffJournal {
  id        String   @id @default(uuid())
  date      DateTime
  activity  String
  notes     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, activity])
}

model IzinKeluar {
  id              String    @id @default(uuid())
  date            DateTime
  waktuKeluar     String
  estimasiKembali String?
  alasan          String
  status          String    @default("MENUNGGU")
  catatanAdmin    String?
  userId          String
  eSignToken      String?
  eSignSignedAt   DateTime?
  eSignSignedBy   String?
  eSignHash       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eSignToken])
}

model Payment {
  id          String   @id @default(uuid())
  studentId   String
  tagihanId   String?
  type        String
  amount      Float
  paymentDate DateTime @default(now())
  month       Int?
  year        Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan     Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tagihanId])
  @@index([year, month])
}

model Tagihan {
  id            String         @id @default(uuid())
  studentId     String
  type          String
  amount        Float
  amountPaid    Float          @default(0)
  month         Int?
  year          Int?
  dueDate       DateTime?
  status        String         @default("BELUM_LUNAS")
  paidDate      DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  paymentProofs PaymentProof[]
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  virtualAccountTransactions VirtualAccountTransaction[]

  @@unique([studentId, type, year, month])
  @@index([studentId, status])
  @@index([year, month, status])
  @@index([type])
}

model Pengeluaran {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float
  category    String   @default("UMUM")
  date        DateTime @default(now())
  recordedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [recordedBy], references: [id])

  @@index([date])
  @@index([category])
}

model PaymentProof {
  id             String    @id @default(uuid())
  studentId      String
  tagihanId      String?
  amount         Float
  proofUrl       String
  fileHash       String?
  status         String    @default("MENUNGGU_VERIFIKASI")
  notes          String?
  verifiedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  fileHashRecord FileHash? @relation(fields: [fileHash], references: [hash])
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan        Tagihan?  @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  verifiedUser   User?     @relation(fields: [verifiedBy], references: [id])
}

model FileHash {
  id            String         @id @default(uuid())
  hash          String         @unique
  filePath      String
  fileSize      Int
  uploadedBy    String
  createdAt     DateTime       @default(now())
  uploader      User           @relation(fields: [uploadedBy], references: [id])
  paymentProofs PaymentProof[]
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  senderId  String?
  type      String
  title     String
  message   String
  data      Json?
  priority  String    @default("NORMAL")
  status    String    @default("UNREAD")
  channel   String    @default("IN_APP")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@index([createdAt])
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  type         String   @unique
  title        String
  message      String
  emailSubject String?
  emailBody    String?
  smsTemplate  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgramConfig {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  defaultSpp      Float    @default(0)
  defaultBeasiswa Float    @default(0) @map("defaultDiscount")
  description     String?
  subtitle        String?
  fullContent     String?
  features        String?  // JSON stringified array of general features/keunggulan
  fasilitasList   String?  // JSON stringified array of fasilitas program
  keunggulanList  String?  // JSON stringified array of keunggulan utama
  iconName        String?  @default("BookOpen")
  logoUrl         String?  // Uploaded custom logo/image program URL or Base64
  badgeColor      String?
  order           Int      @default(0)
  isVisible       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DanaBantuan {
  id                 String    @id @default(uuid())
  namaBantuan        String
  kategori           String    @default("SISWA")
  sumberDana         String    @default("Yayasan")
  nominal            Float
  penerima           String?
  tanggal            DateTime  @default(now())
  status             String    @default("DISETUJUI")
  keterangan         String?
  targetSync         String    @default("KEUANGAN_KELUAR")
  isSynced           Boolean   @default(false)
  syncedAt           DateTime?
  syncedReferenceId String?
  recordedBy         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [recordedBy], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@index([isSynced])
}

model VirtualAccountTransaction {
  id         String    @id @default(uuid())
  studentId  String
  tagihanId  String?
  vaNumber   String
  bankCode   String
  amount     Float
  status     String    @default("PENDING")
  reference  String    @unique
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan    Tagihan?  @relation(fields: [tagihanId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([tagihanId])
  @@index([reference])
}

model WhatsAppLog {
  id             String   @id @default(uuid())
  recipientPhone String
  recipientName  String?
  recipientRole  String?
  category       String   // ABSENSI, TAGIHAN, PEMBAYARAN, INFORMASI, SISTEM
  title          String?
  message        String
  senderNumber   String   @default("088293733330")
  status         String   @default("SENT") // SENT, PENDING, FAILED, SIMULATED
  error          String?
  createdAt      DateTime @default(now())

  @@index([recipientPhone])
  @@index([category])
  @@index([createdAt])
}

model SystemLog {
  id          String    @id @default(uuid())
  category    String    // AUTH, PRESENSI, KEUANGAN, WHATSAPP, AKADEMIK, SISTEM, SECURITY
  level       String    @default("INFO") // INFO, WARN, ERROR, CRITICAL
  action      String    // e.g. "USER_LOGIN", "PAYMENT_CREATED", "ABSEN_FACE", "WA_SEND", etc.
  message     String
  details     Json?     // structured metadata
  ipAddress   String?
  userAgent   String?
  userId      String?
  userName    String?
  userRole    String?
  isArchived  Boolean   @default(false)
  archiveId   String?
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([level])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@index([isArchived])
}

model CompressedLogArchive {
  id                  String    @id @default(uuid())
  filename            String    // e.g. "archives/2026-08/log_2026-08-19.json.gz"
  storagePath         String    // Supabase bucket path e.g. "system-logs/archives/2026-08/log_2026-08-19.json.gz"
  bucketName          String    @default("system-logs")
  category            String    @default("ALL") // ALL, SYSTEM, WHATSAPP, SECURITY, AUDIT
  originalSizeBytes   Int       // bytes before compression
  compressedSizeBytes Int       // bytes after compression (sekecil-kecilnya)
  compressionRatio    Float     // e.g. 92.5 (%)
  compressionAlgo     String    @default("GZIP_LEVEL_9") // GZIP_LEVEL_9, BROTLI_MAX
  recordCount         Int       @default(0)
  startDate           DateTime
  endDate             DateTime
  checksumSha256      String?
  uploadedToSupabase  Boolean   @default(true)
  supabaseUrl         String?
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([bucketName])
}

model CharacterAssessment {
  id              String    @id @default(uuid())
  studentId       String
  evaluatorId     String
  category        String    // ADAB_ETIKA, IBADAH, KEDISIPLINAN, PRESTASI_PENGHARGAAN, PELANGGARAN
  type            String    // POSITIF, NEGATIF, RUTIN, CATATAN_KONSELING
  title           String
  description     String?
