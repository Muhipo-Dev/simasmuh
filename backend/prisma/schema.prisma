model Extracurricular {
  id          String   @id @default(uuid())
  name        String   // e.g. "Hizbul Wathan (HW)", "Tapak Suci", "PMR / KKR", "IPM", "Paskibra", "Futsal", "Basket", "Robotik", "Paduan Suara"
  code        String?  @unique // e.g. "HW", "TS", "PMR"
  category    String   @default("UMUM") // WAJIB_MUHAMMADIYAH, OLAHRAGA, SENI_BUDAYA, KEAGAMAAN, AKADEMIK_SAINS, KEPANDUAN, LAINNYA
  description String?
  scheduleDay String?  // e.g. "Jumat", "Sabtu"
  scheduleTime String? // e.g. "15:30 - 17:00"
  location    String?  // e.g. "Lapangan Utama", "Aula Lt. 3", "Lab Komputer"
  
  // Pembina / Pelatih
  pembinaId   String?  // Relation to TeacherProfile jika pembina adalah guru
  pembinaUserId String? // User ID pembina (jika login sebagai guru/pembina)
  pembinaName String   // Nama Pembina / Pelatih Utama
  pembinaNip  String?  // NIP / NBM Pembina
  pembinaContact String? // No. WA / Telp Pembina
  
  pembina2Name String? // Pembina Pendamping / Asisten (opsional)
  pembina2Contact String?

  logoUrl     String?
  targetPeserta String? @default("Semua Tingkat (X, XI, XII)")
  isActive    Boolean  @default(true)
  
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ExtracurricularMember[]
  sessions    ExtracurricularSession[]
  grades      ExtracurricularGrade[]

  @@index([category])
  @@index([isActive])
  @@index([pembinaId])
  @@index([pembinaUserId])
}

model ExtracurricularMember {
  id                String          @id @default(uuid())
  extracurricularId String
  studentId         String
  role              String          @default("ANGGOTA") // KETUA, WAKIL_KETUA, SEKRETARIS, BENDAHARA, ANGGOTA
  joinedAt          DateTime        @default(now())
  status            String          @default("AKTIF") // AKTIF, NON_AKTIF, ALUMNI
  catatan           String?

  extracurricular   Extracurricular @relation(fields: [extracurricularId], references: [id], onDelete: Cascade)
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendances       ExtracurricularAttendance[]
  grades            ExtracurricularGrade[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([extracurricularId, studentId])
  @@index([extracurricularId])
  @@index([studentId])
}

model ExtracurricularSession {
  id                String                      @id @default(uuid())
  extracurricularId String
  title             String                      // e.g. "Pertemuan 1 - Latihan Fisik", "Rapat Kerja IPM"
  sessionDate       DateTime                    // Tanggal pertemuan
  startTime         String?                     // e.g. "15:30"
  endTime           String?                     // e.g. "17:00"
  location          String?                     // Lokasi pertemuan
  topic             String?                     // Materi / Agenda latihan
  trainerName       String?                     // Pelatih / Pembina yang memimpin
  notes             String?                     // Catatan evaluasi kegiatan

  extracurricular   Extracurricular             @relation(fields: [extracurricularId], references: [id], onDelete: Cascade)
  attendances       ExtracurricularAttendance[]

  createdBy         String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([extracurricularId])
  @@index([sessionDate])
}

model ExtracurricularAttendance {
  id                String                  @id @default(uuid())
  sessionId         String
  memberId          String
  studentId         String
  status            String                  @default("HADIR") // HADIR, IZIN, SAKIT, ALFA
  notes             String?
  recordedAt        DateTime                @default(now())

  session           ExtracurricularSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member            ExtracurricularMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([sessionId, memberId])
  @@index([sessionId])
  @@index([memberId])
  @@index([studentId])
}

model ExtracurricularGrade {
  id                String                  @id @default(uuid())
  extracurricularId String
  memberId          String
  studentId         String
  academicYear      String                  @default("2025/2026")
  semester          String                  @default("GANJIL") // GANJIL, GENAP
  score             Float?                  @default(85) // 0 - 100
  predicate         String                  @default("A") // Sangat Baik / Baik / Cukup / Kurang (A/B/C/D)
  description       String?                 // Keterangan capaian kompetensi rapor

  extracurricular   Extracurricular         @relation(fields: [extracurricularId], references: [id], onDelete: Cascade)
  member            ExtracurricularMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdBy         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([extracurricularId, studentId, academicYear, semester])
  @@index([extracurricularId])
  @@index([memberId])
  @@index([studentId])
}


model StudentAssessment {
  id           String          @id @default(uuid())
  studentId    String
  classId      String
  subjectId    String
  teacherId    String?         // Guru pengampu yang mengisi/mengimport
  academicYear String          @default("2025/2026")
  semester     Int             @default(1) // 1 = Ganjil, 2 = Genap

  // Nilai Formatif Lingkup Materi 1-5 (masing-masing memiliki TP1-TP4)
  lm1_tp1      Float?
  lm1_tp2      Float?
  lm1_tp3      Float?
  lm1_tp4      Float?

  lm2_tp1      Float?
  lm2_tp2      Float?
  lm2_tp3      Float?
  lm2_tp4      Float?

  lm3_tp1      Float?
  lm3_tp2      Float?
  lm3_tp3      Float?
  lm3_tp4      Float?

  lm4_tp1      Float?
  lm4_tp2      Float?
  lm4_tp3      Float?
  lm4_tp4      Float?

  lm5_tp1      Float?
  lm5_tp2      Float?
  lm5_tp3      Float?
  lm5_tp4      Float?

  // Sumatif Lingkup Materi (LM1 - LM5)
  sum_lm1      Float?
  sum_lm2      Float?
  sum_lm3      Float?
  sum_lm4      Float?
  sum_lm5      Float?

  // Asesmen Sumatif Semester
  sts          Float?          // Sumatif Tengah Semester
  sas          Float?          // Sumatif Akhir Semester

  // Nilai Rata-rata & Akhir Terkalkulasi
  formatifAvg  Float?
  sumatifLmAvg Float?
  finalScore   Float?

  notes        String?         // Catatan guru pengampu mapel
  raporCapaianKompetensi String? // Deskripsi capaian kompetensi e-raport (Wali Kelas)
  raporCatatanWali       String? // Catatan / masukan wali kelas untuk e-raport

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, academicYear, semester])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicYear, semester])
}

model UserFaceBiometric {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Vektor 512-dimensi hasil FaceNet Inception-ResNet-v1 (disimpan utuh dalam array float & base64/JSON)
  embedding       Float[]
  vectorDimension Int      @default(512)
  modelName       String   @default("Inception-ResNet-v1 (Bio-Fusion AI)")
  
  // Foto Profil asli yang disimpan utuh di database (Base64 JPEG/PNG)
  photoDataUrl    String?  @db.Text
  
  // Foto multi-sudut (5 arah + liveness: front, right, left, up, down, blink, mouth_open)
  // Disimpan dalam format JSON Record<angle, base64DataUrl>
  samplePhotos    Json?
  sampleCount     Int      @default(0)
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model CapaianPembelajaran {
  id           String   @id @default(uuid())
  fase         String   // FASE_E (Kelas X), FASE_F (Kelas XI - XII)
  gradeLevel   Int      // 10, 11, 12
  subjectCode  String?
  subjectName  String   // e.g. "Matematika", "Informatika"
  elemen       String   // e.g. "Bilangan", "Aljabar dan Fungsi", "Algoritma dan Pemrograman"
  deskripsiCp  String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tujuanPembelajarans TujuanPembelajaran[]

  @@index([fase, subjectName])
  @@index([gradeLevel])
}

model PerangkatKurikulum {
  id                 String   @id @default(uuid())
  teacherId          String
  classId            String
  subjectId          String
  academicYear       String   @default("2025/2026")
  semester           String   @default("GANJIL") // GANJIL, GENAP
  fase               String   @default("FASE_E") // FASE_E, FASE_F
  jenisKurikulum     String   @default("KURIKULUM_MERDEKA") // KURIKULUM_MERDEKA, KURIKULUM_2013, KURIKULUM_NASIONAL_PLUS, DLL

  totalJpSemester    Int      @default(36) // Total alokasi JP dalam 1 semester
  jpPerMinggu        Int      @default(2)  // Alokasi JP tatap muka per minggu
  mingguEfektifCount Int      @default(18) // Jumlah minggu efektif (default 18)

  statusSupervisi    String   @default("DRAFT") // DRAFT, SIAP, DIAJUKAN, TERVERIFIKASI
  catatanKurikulum   String?  @db.Text

  teacher            TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class              Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  tujuanPembelajarans TujuanPembelajaran[]
  promesAllocations   PromesAllocation[]
  dokumenItems        PerangkatAjarItem[]
  nilaiSiswaTps       NilaiSiswaTP[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([teacherId, classId, subjectId, academicYear, semester])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([academicYear, semester])
}

model TujuanPembelajaran {
  id                   String              @id @default(uuid())
  perangkatKurikulumId String
  cpId                 String?

  kodeTp               String              // e.g. "TP 1", "TP 2", "10.1", "10.2"
  orderIndex           Int                 @default(1)
  lingkupMateri        String              // Lingkup Materi / Bab / Elemen
  materiPokok          String              // Rincian topik inti
  deskripsiTp          String              @db.Text // Rumusan Tujuan Pembelajaran (ABCD)
  alokasiJp            Int                 @default(4) // Jam Pelajaran
  dimensiProfilPancasila String?           // JSON array string

  perangkatKurikulum   PerangkatKurikulum  @relation(fields: [perangkatKurikulumId], references: [id], onDelete: Cascade)
  capaianPembelajaran  CapaianPembelajaran? @relation(fields: [cpId], references: [id], onDelete: SetNull)
  promesAllocations    PromesAllocation[]
  dokumenItems         PerangkatAjarItem[]
  nilaiSiswaTps        NilaiSiswaTP[]
  teachingJournals     TeachingJournal[]
  alurTujuanPembelajarans AlurTujuanPembelajaran[]
  modulAjars           ModulAjar[]
  kktps                Kktp[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([perangkatKurikulumId])
  @@index([orderIndex])
  @@index([cpId])
}

model AlurTujuanPembelajaran {
  id           String             @id @default(uuid())
  tpId         String
  teacherId    String
  classId      String
  subjectId    String
  fase         String             // FASE_E, FASE_F
  academicYear String             @default("2025/2026")
  semester     String             @default("GANJIL") // GANJIL, GENAP
  
  sequence     Int                @default(1) // Urutan kronologis pengajaran
  alokasiJp    Int                @default(4) // Alokasi waktu JP
  keterangan   String?            @db.Text

  tujuanPembelajaran TujuanPembelajaran @relation(fields: [tpId], references: [id], onDelete: Cascade)
  teacher            TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class              Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tpId, classId, semester, academicYear])
  @@index([tpId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([sequence])
}

model ModulAjar {
  id           String             @id @default(uuid())
  tpId         String             // Relasi wajib / tag spesifik ke TP
  teacherId    String
  classId      String
  subjectId    String
  scheduleId   String?

  judul        String             // Judul Modul Ajar (pengganti RPP)
  deskripsi    String?            @db.Text
  kontenJson   Json?              // Komponen inti: Apersepsi, Pemantik, Kegiatan Inti, Penutup, Media/LKPD
  fileDocxUrl  String?
  filePdfUrl   String?
  status       String             @default("SIAP") // DRAFT, SIAP, SUPERVISI

  tujuanPembelajaran TujuanPembelajaran @relation(fields: [tpId], references: [id], onDelete: Cascade)
  teacher            TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class              Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schedule           Schedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  kktps              Kktp[]
  teachingJournals   TeachingJournal[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tpId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([scheduleId])
}

model Kktp {
  id                   String             @id @default(uuid())
  tpId                 String             // Terhubung ke Tujuan Pembelajaran
  modulAjarId          String?            // Terhubung ke Modul Ajar
  
  tipePendekatan       String             @default("DESKRIPSI_KRITERIA") // DESKRIPSI_KRITERIA, RUBRIK, INTERVAL_NILAI
  deskripsiKualitatif  String             @db.Text // Deskripsi/bukti kinerja murid kualitatif (bukan Int angka kaku)
  rubrikJson           Json?              // Struktur rubrik: { belumBerkembang, mulaiBerkembang, berkembangSesuaiHarapan, sangatBerkembang }
  tindakLanjutRemedial String?            @db.Text // Rekomendasi intervensi perbaikan
  tindakLanjutPengayaan String?           @db.Text // Rekomendasi pengayaan

  tujuanPembelajaran   TujuanPembelajaran @relation(fields: [tpId], references: [id], onDelete: Cascade)
  modulAjar            ModulAjar?         @relation(fields: [modulAjarId], references: [id], onDelete: Cascade)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tpId])
  @@index([modulAjarId])
}

model PromesAllocation {
  id                   String             @id @default(uuid())
  perangkatKurikulumId String
  tpId                 String

  bulanIndex           Int                // 1 s.d. 6 (Juli - Desember / Januari - Juni)
  namaBulan            String             // "Juli", "Agustus", dst.
  mingguKe             Int                // 1, 2, 3, 4, 5
  mingguAbsolut        Int                // Minggu 1 s.d. 18 efektif
  alokasiJp            Int                @default(2) // JP yang dialokasikan di blok ini
  keterangan           String?            // "KBM", "STS", "SAS", "Libur", dll.

  perangkatKurikulum   PerangkatKurikulum @relation(fields: [perangkatKurikulumId], references: [id], onDelete: Cascade)
  tujuanPembelajaran   TujuanPembelajaran @relation(fields: [tpId], references: [id], onDelete: Cascade)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([perangkatKurikulumId, tpId, mingguAbsolut])
  @@index([perangkatKurikulumId])
  @@index([tpId])
}

model PerangkatAjarItem {
  id                   String             @id @default(uuid())
  perangkatKurikulumId String
  tpId                 String?

  kategori             String             // MODUL_AJAR, LKPD, SOAL_HARIAN, ASESMEN_SUMATIF, KISI_KISI, SOAL_STS, SOAL_SAS, SILABUS, PROTA, PROMES
  judul                String
  kontenJson           Json?              // Struktur kaya: tujuan, apersepsi, kegiatan inti, penutup, rubrik, soal, kunci
  fileDocxUrl          String?
  filePdfUrl           String?
  statusDraft          String             @default("SIAP") // DRAFT, SIAP

  perangkatKurikulum   PerangkatKurikulum @relation(fields: [perangkatKurikulumId], references: [id], onDelete: Cascade)
  tujuanPembelajaran   TujuanPembelajaran? @relation(fields: [tpId], references: [id], onDelete: SetNull)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([perangkatKurikulumId])
  @@index([tpId])
  @@index([kategori])
}

model NilaiSiswaTP {
  id                   String             @id @default(uuid())
  perangkatKurikulumId String
  studentId            String
  tpId                 String

  nilaiFormatif        Float?             // 0 - 100
  nilaiSumatif         Float?             // Nilai tes sumatif lingkup materi TP
  catatanProgres       String?            // e.g. "Sangat menguasai konsep..."

  perangkatKurikulum   PerangkatKurikulum @relation(fields: [perangkatKurikulumId], references: [id], onDelete: Cascade)
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tujuanPembelajaran   TujuanPembelajaran @relation(fields: [tpId], references: [id], onDelete: Cascade)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([perangkatKurikulumId, studentId, tpId])
  @@index([perangkatKurikulumId])
  @@index([studentId])
  @@index([tpId])
}



