  namaKegiatan     String             // e.g. Kajian Selasa Pagi
  kategori         String             @default("KAJIAN_SELASA_PAGI") // KAJIAN_SELASA_PAGI, SHOLAT_JUMAT, MABIT_TAQWA, BAITUL_ARQAM, TADARUS_TAHFIDZ, PENGAJIAN_AKBAR, KEGIATAN_ISMUBA, WORKSHOP_PELATIHAN, UPACARA_APEL, RAPAT_KHUSUS, KEGIATAN_LAIN
  sifatKegiatan    String             @default("TERJADWAL") // TERJADWAL (Tampil di Kalender), MENDESAK (Hanya Absensi QR, tidak tampil di Kalender)
  tanggal          DateTime           @default(now())
  waktuMulai       String?            // e.g. 06:45
  waktuSelesai     String?            // e.g. 07:30
  tempat           String             @default("Masjid / Aula Utama")
