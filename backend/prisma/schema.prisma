  presensis        PresensiKegiatan[]

  @@index([kategori])
  @@index([sifatKegiatan])
  @@index([status])
  @@index([tanggal])
  @@index([qrCodeToken])
  @@index([createdAt])
}

model PresensiKegiatan {
