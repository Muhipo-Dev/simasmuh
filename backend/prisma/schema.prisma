generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(uuid())
  username          String            @unique
  email             String?           @unique
  password          String
  name              String
  role              String            @default("GURU")
  phone             String?
  avatarUrl         String?
  address           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subRole           String?
  subRole2          String?
  subRole3          String?
  nipNbm            String?
  announcements     Announcement[]
  dailyAttendances  DailyAttendance[]
  uploadedFiles     FileHash[]
  izinKeluars       IzinKeluar[]
  sentNotifications Notification[]    @relation("NotificationSender")
  notifications     Notification[]
  paymentProofs     PaymentProof[]
  pengeluarans      Pengeluaran[]
  danaBantuans      DanaBantuan[]
  staffJournals     StaffJournal[]
  student           Student?
  teacherProfile    TeacherProfile?
  parentProfile     ParentProfile?
  sessions          UserSession[]
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String?
  ipAddress   String?
  userAgent   String?
  device      String?
  browser     String?
  os          String?
  isActive    Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isActive])
}

model TeacherProfile {
  id                  String            @id @default(uuid())
  nip                 String?           @unique
  phone               String?
  lastEducation       String?
  certificationStatus String?
  certificationYear   Int?
  userId              String            @unique
  homeroomClasses     Class[]           @relation("HomeroomTeacher")
  homeroomJournals    HomeroomJournal[]
  schedules           Schedule[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingJournals    TeachingJournal[]
}

model ParentProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  phone               String?
  occupation          String?
  address             String?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students            ParentStudent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model ParentStudent {
  id                  String            @id @default(uuid())
  parentId            String
  studentId           String
  relation            String?           @default("ORANG_TUA") // AYAH, IBU, WALI, ORANG_TUA
  parent              ParentProfile     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Class {
  id                String          @id @default(uuid())
  name              String
  gradeLevel        Int
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   TeacherProfile? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  schedules         Schedule[]
  students          Student[]
}

model Student {
  id                 String         @id @default(uuid())
  nisn               String         @unique
  nis                String         @unique
  name               String
  gender             String
  classId            String
  userId             String?        @unique
  phone              String?
  parentPhone        String?
  program            String?
  gelombang          String?        @default("Gelombang 1")
  jalurPendaftaran   String?        @default("Mandiri")
  beasiswaPercentage Int            @default(0) @map("discountPercentage")
  beasiswaReason     String?        @map("discountReason")
  beasiswaSeragamPct Int            @default(0)
  beasiswaSppPct     Int            @default(0)
  beasiswaDppPct     Int            @default(0)
  bioData            String?
  attendances        Attendance[]
  grades             Grade[]
  payments           Payment[]
  paymentProofs      PaymentProof[]
  parentRelations    ParentStudent[]
  class              Class          @relation(fields: [classId], references: [id])
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagihans           Tagihan[]
  virtualAccountTransactions VirtualAccountTransaction[]

  @@index([classId])
}

model Subject {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  grades    Grade[]
  schedules Schedule[]
}

model Schedule {
  id               String            @id @default(uuid())
  dayOfWeek        Int
  startTime        String
  endTime          String
  classId          String
  subjectId        String
  teacherId        String
  attendances      Attendance[]
  class            Class             @relation(fields: [classId], references: [id])
  subject          Subject           @relation(fields: [subjectId], references: [id])
  teacher          TeacherProfile    @relation(fields: [teacherId], references: [id])
  teachingJournals TeachingJournal[]
}

model Attendance {
  id         String   @id @default(uuid())
  date       DateTime
  status     String
  studentId  String
  scheduleId String
  createdAt  DateTime @default(now())
  location   String?
  photoUrl   String?
  updatedAt  DateTime @updatedAt
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])
}

model DailyAttendance {
  id           String   @id @default(uuid())
  date         DateTime
  checkInTime  String?
  checkOutTime String?
  time         String
  status       String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@index([date])
}

model Grade {
  id        String  @id @default(uuid())
  type      String
  score     Float
  studentId String
  subjectId String
  semester  Int
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
}

model TeachingJournal {
  id         String         @id @default(uuid())
  date       DateTime
  material   String
  notes      String?
  scheduleId String
  teacherId  String
  photoUrl   String?
  schedule   Schedule       @relation(fields: [scheduleId], references: [id])
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
}

model HomeroomJournal {
  id          String         @id @default(uuid())
  date        DateTime
  notes       String
  actionTaken String?
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
}

model Setting {
  id                  String  @id @default(uuid())
  schoolName          String
  address             String
  phone               String?
  email               String?
  logoUrl             String?
  principalName       String?
  principalNip        String?
  qrPublicToken       String?
  bankName            String?
  bankNumber          String?
  bankOwner           String?
  academicYear        String? @default("2026/2027")
  semester            String? @default("Ganjil")
  defaultDpp           Float?  @default(0)
  defaultUka           Float?  @default(0)
  defaultUks           Float?  @default(0)
  defaultInfaq         Float?  @default(0)
  defaultSeragam       Float?  @default(2000000)
  whatsappSenderNumber String? @default("088293733330")
  whatsappApiKey       String?
  whatsappApiUrl       String?
  helpdeskPhone        String? @default("088293733330")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  eventDate DateTime?
  image     String?
  type      String    @default("BERITA")
  author    User      @relation(fields: [authorId], references: [id])
}

model StaffJournal {
  id        String   @id @default(uuid())
  date      DateTime
  activity  String
  notes     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IzinKeluar {
  id              String   @id @default(uuid())
  date            DateTime
  waktuKeluar     String
  estimasiKembali String?
  alasan          String
  status          String   @default("MENUNGGU")
  catatanAdmin    String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(uuid())
  studentId   String
  tagihanId   String?
  type        String
  amount      Float
  paymentDate DateTime @default(now())
  month       Int?
  year        Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan     Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tagihanId])
  @@index([year, month])
}

model Tagihan {
  id            String         @id @default(uuid())
  studentId     String
  type          String
  amount        Float
  amountPaid    Float          @default(0)
  month         Int?
  year          Int?
  dueDate       DateTime?
  status        String         @default("BELUM_LUNAS")
  paidDate      DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  paymentProofs PaymentProof[]
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  virtualAccountTransactions VirtualAccountTransaction[]

  @@index([studentId, status])
  @@index([year, month, status])
  @@index([type])
}

model Pengeluaran {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float
  category    String   @default("UMUM")
  date        DateTime @default(now())
  recordedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [recordedBy], references: [id])

  @@index([date])
  @@index([category])
}

model PaymentProof {
  id             String    @id @default(uuid())
  studentId      String
  tagihanId      String?
  amount         Float
  proofUrl       String
  fileHash       String?
  status         String    @default("MENUNGGU_VERIFIKASI")
  notes          String?
  verifiedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  fileHashRecord FileHash? @relation(fields: [fileHash], references: [hash])
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan        Tagihan?  @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  verifiedUser   User?     @relation(fields: [verifiedBy], references: [id])
}

model FileHash {
  id            String         @id @default(uuid())
  hash          String         @unique
  filePath      String
  fileSize      Int
  uploadedBy    String
  createdAt     DateTime       @default(now())
  uploader      User           @relation(fields: [uploadedBy], references: [id])
  paymentProofs PaymentProof[]
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  senderId  String?
  type      String
  title     String
  message   String
  data      Json?
  priority  String    @default("NORMAL")
  status    String    @default("UNREAD")
  channel   String    @default("IN_APP")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@index([createdAt])
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  type         String   @unique
  title        String
  message      String
  emailSubject String?
  emailBody    String?
  smsTemplate  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgramConfig {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  defaultSpp      Float    @default(0)
  defaultBeasiswa Float    @default(0) @map("defaultDiscount")
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DanaBantuan {
  id                 String    @id @default(uuid())
  namaBantuan        String
  kategori           String    @default("SISWA")
  sumberDana         String    @default("Yayasan")
  nominal            Float
  penerima           String?
  tanggal            DateTime  @default(now())
  status             String    @default("DISETUJUI")
  keterangan         String?
  targetSync         String    @default("KEUANGAN_KELUAR")
  isSynced           Boolean   @default(false)
  syncedAt           DateTime?
  syncedReferenceId String?
  recordedBy         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [recordedBy], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@index([isSynced])
}

model VirtualAccountTransaction {
  id         String    @id @default(uuid())
  studentId  String
  tagihanId  String?
  vaNumber   String
  bankCode   String
  amount     Float
  status     String    @default("PENDING")
  reference  String    @unique
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagihan    Tagihan?  @relation(fields: [tagihanId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([tagihanId])
  @@index([reference])
}

model WhatsAppLog {
  id             String   @id @default(uuid())
  recipientPhone String
  recipientName  String?
  recipientRole  String?
  category       String   // ABSENSI, TAGIHAN, PEMBAYARAN, INFORMASI, SISTEM
  title          String?
  message        String
  senderNumber   String   @default("088293733330")
  status         String   @default("SENT") // SENT, PENDING, FAILED, SIMULATED
  error          String?
  createdAt      DateTime @default(now())

  @@index([recipientPhone])
  @@index([category])
  @@index([createdAt])
}

model SystemLog {
  id          String    @id @default(uuid())
  category    String    // AUTH, PRESENSI, KEUANGAN, WHATSAPP, AKADEMIK, SISTEM, SECURITY
  level       String    @default("INFO") // INFO, WARN, ERROR, CRITICAL
  action      String    // e.g. "USER_LOGIN", "PAYMENT_CREATED", "ABSEN_FACE", "WA_SEND", etc.
  message     String
  details     Json?     // structured metadata
  ipAddress   String?
  userAgent   String?
  userId      String?
  userName    String?
  userRole    String?
  isArchived  Boolean   @default(false)
  archiveId   String?
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([level])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@index([isArchived])
}

model CompressedLogArchive {
  id                  String    @id @default(uuid())
  filename            String    // e.g. "archives/2026-08/log_2026-08-19.json.gz"
  storagePath         String    // Supabase bucket path e.g. "system-logs/archives/2026-08/log_2026-08-19.json.gz"
  bucketName          String    @default("system-logs")
  category            String    @default("ALL") // ALL, SYSTEM, WHATSAPP, SECURITY, AUDIT
  originalSizeBytes   Int       // bytes before compression
  compressedSizeBytes Int       // bytes after compression (sekecil-kecilnya)
  compressionRatio    Float     // e.g. 92.5 (%)
  compressionAlgo     String    @default("GZIP_LEVEL_9") // GZIP_LEVEL_9, BROTLI_MAX
  recordCount         Int       @default(0)
  startDate           DateTime
  endDate             DateTime
  checksumSha256      String?
  uploadedToSupabase  Boolean   @default(true)
  supabaseUrl         String?
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([bucketName])
}
