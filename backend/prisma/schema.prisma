  tingkat          String    // KELAS, SEKOLAH, KECAMATAN, KABUPATEN, PROVINSI, NASIONAL, INTERNASIONAL
  peringkat        String?   // Juara 1, Juara 2, Juara 3, Harapan 1, Medali Emas, Finalis, dsb.
  penyelenggara    String?   // Lembaga / Instansi Penyelenggara
  tahun            Int       // Tahun perolehan prestasi (misal: 2026)
